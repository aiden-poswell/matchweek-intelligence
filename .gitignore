# Raw source snapshots and any private investigation material — never tracked.
data/raw/
data/private/
data/processed/
*_PRIVATE.*
*_REVIEW.csv

# Python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
.venv/
build/
dist/

# Local/editor
.vscode/
.idea/
*.log

# Web app build tooling and output — never tracked; web/public/data/replays.json
# (the intentional derived public artifact) and web/src, web/package*.json etc. are
# ordinary tracked source and are NOT excluded by this.
web/node_modules/
web/dist/
web/.vite/
web/coverage/

# Scratch, local-only QA/automation scripts used during manual browser verification
# (not app source, never shipped, never part of the reviewed diff/zip).
web/.qa-*.mjs

# Secrets
.env
.env.*
